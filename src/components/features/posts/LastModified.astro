---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

interface Props {
	updatedDate: Date;
	class?: string;
}

dayjs.extend(utc);

const { updatedDate, class: className } = Astro.props;

const lastModified = dayjs(updatedDate).utc().format("YYYY-MM-DDTHH:mm:ss");

// 语言键值在这里就渲染进 DOM，客户端脚本只负责按秒重算，不需要再去读隐藏节点。
const runtimeStrings = {
	prefix: i18n(I18nKey.lastModifiedPrefix),
	year: i18n(I18nKey.year),
	month: i18n(I18nKey.month),
	day: i18n(I18nKey.day),
	hour: i18n(I18nKey.hour),
	minute: i18n(I18nKey.minute),
	second: i18n(I18nKey.second),
};
---

<>
	<div
		id="last-modified"
		data-last-modified={lastModified}
		data-prefix={i18n(I18nKey.lastModifiedPrefix)}
		data-year={i18n(I18nKey.year)}
		data-month={i18n(I18nKey.month)}
		data-day={i18n(I18nKey.day)}
		data-hour={i18n(I18nKey.hour)}
		data-minute={i18n(I18nKey.minute)}
		data-second={i18n(I18nKey.second)}
		style="display: none;"
	>
	</div>

	<div class:list={["card-base p-6 mb-4", className]}>
		<script
			is:inline
			data-swup-ignore-script
			define:vars={{
				strings: runtimeStrings,
			}}
		>
			// 持久化脚本：只执行一次，自己负责跨 Swup 切页持续更新。
			// 这里必须用 querySelectorAll + 属性选择器来定位「当前页面的」时间节点，
			// 否则切页后会继续往上一页的 DOM 里写（原来就是这个问题）。
			(function () {
				if (window.__lastModifiedRuntime) {
					return;
				}
				window.__lastModifiedRuntime = true;

				function formatRuntime(diffMs) {
					const seconds = Math.floor(diffMs / 1000);
					const days = Math.floor(seconds / 86400);
					const hours = Math.floor((seconds % 86400) / 3600);
					const minutes = Math.floor((seconds % 3600) / 60);
					const secs = seconds % 60;

					const years = Math.floor(days / 365);
					const months = Math.floor((days % 365) / 30);
					const remainingDays = days % 30;

					let text = strings.prefix + " ";
					if (years > 0) {
						text += `${years} ${strings.year} `;
					}
					if (months > 0) {
						text += `${months} ${strings.month} `;
					}
					if (remainingDays > 0) {
						text += `${remainingDays} ${strings.day} `;
					}
					text += `${hours} ${strings.hour} `;
					text += `${minutes < 10 ? "0" + minutes : minutes} ${strings.minute} `;
					text += `${secs < 10 ? "0" + secs : secs} ${strings.second}`;
					return text;
				}

				function runtime() {
					const markers = Array.from(
						document.querySelectorAll(
							'div[id="last-modified"][data-last-modified]',
						),
					);
					for (const marker of markers) {
						// 当前页面里的显示节点（marker 与显示节点同属一个页面区块）
						const container =
							marker.closest("main") ?? document.body;
						const target =
							container.querySelector("#modifiedtime");
						if (!target) {
							continue;
						}

						const startDate = new Date(
							marker.getAttribute("data-last-modified") ?? "",
						);
						if (Number.isNaN(startDate.getTime())) {
							continue;
						}

						target.textContent = formatRuntime(
							Date.now() - startDate.getTime(),
						);
					}
				}

				runtime();
				setInterval(runtime, 1000);
			})();
		</script>
		<div class="flex items-center gap-3">
			<div
				class="flex items-center justify-center h-12 w-12 rounded-lg bg-[var(--enter-btn-bg)]"
			>
				<Icon
					name="material-symbols:history-rounded"
					class="text-3xl text-[var(--primary)]"
				/>
			</div>
			<div class="flex flex-col gap-1">
				<div
					id="modifiedtime"
					class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75"
				>
				</div>
				<p
					class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75"
				>
					{i18n(I18nKey.lastModifiedOutdated)}
				</p>
			</div>
		</div>
	</div>
</>
