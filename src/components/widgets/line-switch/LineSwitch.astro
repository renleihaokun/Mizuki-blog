---
import { lineSwitchConfig } from "@/config"; 
import WidgetLayout from "../common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
const lines = lineSwitchConfig;
---

<WidgetLayout name="线路切换" id="line-switch" class={className} style={style}>
    <div slot="title-icon" class="ml-auto mr-4 flex items-center">
        <button 
            class="line-switch-toggle-btn btn-regular rounded-lg h-8 w-8 active:scale-95 transition-all flex items-center justify-center"
            aria-label="Toggle collapse"
        >
            <iconify-icon 
                class="line-switch-arrow"
                icon="material-symbols:keyboard-arrow-up-rounded" 
                width="20" 
                height="20"
                style="transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); color: var(--primary);"
            ></iconify-icon>
        </button>
    </div>

    <div class="line-switch-inner-content flex flex-col gap-2 mb-2 overflow-hidden">
        {lines.map((line) => (
            <a 
                href={line.url}
                data-hostname={new URL(line.url).hostname}
                data-line-id={line.id}
                class="line-item-link group block w-full no-underline"
            >
                <button
                    class="w-full h-12 rounded-lg bg-black/[0.03] dark:bg-white/[0.03] hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition-all pl-4 hover:pl-5 text-left cursor-pointer flex items-center"
                >
                    <div class="flex items-center justify-between w-full relative mr-4">
                        <div class="flex items-center gap-2 overflow-hidden">
                            <div class="flex items-center text-[14px] line-name-container text-90">
                                <span class="line-name-en overflow-hidden opacity-0 w-0 whitespace-nowrap text-left">{line.nameEn}</span>
                                <span class="line-name-zh truncate font-medium">{line.nameZh}</span>
                            </div>
                            <div class="flex items-center justify-center flex-shrink-0" style={`width: ${line.size}px; height: ${line.size}px`}>
                                {line.isLocal ? (
                                    <img src={line.icon} alt="" style={`width: ${line.size}px; height: auto;`} class="flex-shrink-0" />
                                ) : (
                                    <iconify-icon icon={line.icon} width={line.size} height={line.size} class="flex-shrink-0" />
                                )}
                            </div>
                        </div>
                        <div class="latency-badge transition px-2 h-6 min-w-[2.5rem] rounded-lg text-[10px] font-bold font-mono flex items-center justify-center ml-2">
                            ---
                        </div>
                    </div>
                </button>
            </a>
        ))}
    </div>
</WidgetLayout>

<style is:global>
    /* 1. 基础容器与卡片样式适配 */
    widget-layout[data-id="line-switch"] {
        display: block !important;
        background-color: var(--card-bg) !important;
    }

    /* 2. 动画修复：精准复刻老版本曲线 */
    .line-switch-inner-content {
        transition: max-height 0.8s cubic-bezier(0.22, 1, 0.36, 1), 
                    opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
                    margin 0.8s cubic-bezier(0.22, 1, 0.36, 1),
                    padding 0.8s cubic-bezier(0.22, 1, 0.36, 1) !important;
        max-height: 1200px;
        opacity: 1;
    }

    .line-switch-inner-content.collapsed {
        max-height: 0 !important;
        opacity: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        pointer-events: none;
    }

    .line-switch-arrow {
        transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) !important;
    }
    .line-switch-arrow.collapsed {
        transform: rotate(180deg) !important;
    }

    /* 3. 背景色逻辑（还原 95%/85%/75% 逻辑） */
    .line-item-link button {
        background: color-mix(in oklch, var(--primary), transparent 95%) !important;
        border: none !important;
        transition: all 0.2s ease-in-out;
    }
    :global(.dark) .line-item-link button {
        background: color-mix(in oklch, var(--primary), transparent 92%) !important;
    }
    .line-item-link button:hover {
        background: color-mix(in oklch, var(--primary), transparent 85%) !important;
    }
    :global(.dark) .line-item-link button:hover {
        background: color-mix(in oklch, var(--primary), transparent 80%) !important;
    }
    .line-item-link.active button {
        background: color-mix(in oklch, var(--primary), transparent 75%) !important;
    }
    :global(.dark) .line-item-link.active button {
        background: color-mix(in oklch, var(--primary), transparent 60%) !important;
    }

    /* 4. 核心修复：暗色模式文字颜色已通过 text-90 类处理 */
    
    /* 悬停和激活状态下文字变主题色 */
    .line-item-link button:hover .line-name-zh,
    .line-item-link.active .line-name-zh {
        color: var(--primary) !important;
    }

    /* 5. 交互与其它 */
    .line-switch-toggle-btn, .line-item-link, .line-item-link button {
        cursor: pointer !important;
    }

    .line-item-link:hover .line-name-en {
        width: 71px;
        opacity: 1;
        margin-right: 4px;
    }
    .line-name-en {
        transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    
    .latency-badge.ok { color: #10b981 !important; background: rgba(16, 185, 129, 0.1) !important; }
    .latency-badge.lime { color: #84cc16 !important; background: rgba(132, 204, 22, 0.1) !important; }
    .latency-badge.warn { color: #f59e0b !important; background: rgba(245, 158, 11, 0.1) !important; }
    .latency-badge.err { color: #ef4444 !important; background: rgba(239, 68, 68, 0.1) !important; }
</style>

<script>
    import { siteConfig } from "@/config";

    async function getPing(url: string) {
        const ctrl = new AbortController();
        const tid = setTimeout(() => ctrl.abort(), 2000);
        try {
            const target = new URL(url);
            const start = performance.now();
            await fetch(target.origin + '/', {
                method: 'HEAD',
                mode: 'no-cors',
                cache: 'reload',
                signal: ctrl.signal
            });
            return Math.round(performance.now() - start);
        } catch { return -1; } finally { clearTimeout(tid); }
    }

    async function updateBadge(id: string, url: string, container: HTMLElement) {
        const badge = container.querySelector(`[data-line-id="${id}"] .latency-badge`);
        if(!badge) return;

        await getPing(url); 
        let results = [];
        for(let i=0; i<5; i++) {
            const ms = await getPing(url);
            if(ms > 0) results.push(ms);
            await new Promise(r => setTimeout(r, 60));
        }
        
        const res = results.length > 0 ? Math.min(...results) : -1;
        badge.classList.remove('ok','warn','err');
        if(res < 0) { badge.textContent = 'ERR'; badge.classList.add('err'); }
        else {
            badge.textContent = res + 'ms';
            if(res < 150) badge.classList.add('ok');
            else if(res < 300) badge.classList.add('warn');
            else badge.classList.add('err');
        }
    }

    function initLineSwitch() {
        const widgets = document.querySelectorAll('widget-layout[data-id="line-switch"]');
        
        widgets.forEach(widget => {
            const container = widget as HTMLElement;
            const btn = container.querySelector('.line-switch-toggle-btn');
            const content = container.querySelector('.line-switch-inner-content') as HTMLElement;
            const arrow = container.querySelector('.line-switch-arrow');
            const currentHostname = window.location.hostname;

            if(!btn || !content || !arrow) return;

            const mainHostname = new URL(siteConfig.siteURL).hostname;
            if (currentHostname === mainHostname && !container.hasAttribute('data-inited')) {
                content.classList.add('collapsed');
                arrow.classList.add('collapsed');
                content.style.maxHeight = '0px';
            }
            container.setAttribute('data-inited', 'true');

            (btn as HTMLElement).onclick = (e) => {
                e.preventDefault();
                const isCollapsed = content.classList.contains('collapsed');
                if(isCollapsed) {
                    content.classList.remove('collapsed');
                    arrow.classList.remove('collapsed');
                    content.style.maxHeight = content.scrollHeight + 'px';
                    setTimeout(() => {
                        if (!content.classList.contains('collapsed')) {
                            content.style.maxHeight = '1200px';
                        }
                    }, 800);
                } else {
                    content.style.maxHeight = content.scrollHeight + 'px';
                    content.offsetHeight;
                    content.classList.add('collapsed');
                    arrow.classList.add('collapsed');
                    content.style.maxHeight = '0px';
                }
            };

            container.querySelectorAll('.line-item-link').forEach(link => {
                const id = link.getAttribute('data-line-id');
                const url = link.getAttribute('href');
                if (link.getAttribute('data-hostname') === currentHostname) {
                    link.classList.add('active');
                }
                if(id && url) setTimeout(() => updateBadge(id, url, container), 1000);
            });
        });
    }

    initLineSwitch();
    document.addEventListener('astro:page-load', initLineSwitch);
</script>