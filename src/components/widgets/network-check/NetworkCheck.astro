---
import { Icon } from "astro-icon/components";

import WidgetLayout from "../common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
---

<network-check-widget style="display: contents;">
	<WidgetLayout
		name="看看你的网"
		id="network-check"
		class={className}
		style={style}
	>
		<a
			slot="title-icon"
			href="#"
			target="_blank"
			rel="noopener noreferrer"
			class="net-api-link ml-0.5 w-8 h-8 rounded-lg flex items-center justify-center transition-all bg-transparent hover:bg-[var(--btn-plain-bg-hover)]"
			title="访问 API 网页"
		>
			<Icon
				name="material-symbols:link"
				class="text-xl text-[var(--primary)] -rotate-45"
			/>
		</a>
		<div class="network-info-container text-sm space-y-3 mb-2 px-2">
			<div
				class="net-loading flex items-center justify-center gap-2 py-4 text-neutral-500 dark:text-neutral-400"
			>
				<Icon name="fa7-solid:spinner" class="text-2xl animate-spin" />
				<span>正在检测网络...</span>
			</div>

			<div class="net-data hidden flex-col gap-3">
				<!-- IP -->
				<div class="flex flex-col bg-[var(--card-bg)] rounded-lg">
					<span
						class="text-xs text-neutral-500 dark:text-neutral-400 mb-1"
						>IP 地址</span
					>
					<div class="flex items-center gap-2">
						<span
							class="net-ip font-bold text-lg text-[var(--primary)] font-mono break-all"
						></span>
					</div>
				</div>

				<!-- Node & Location -->
				<div class="grid grid-cols-2 gap-2">
					<div class="flex flex-col overflow-hidden">
						<span
							class="text-xs text-neutral-500 dark:text-neutral-400 mb-1"
							>连接节点</span
						>
						<div
							class="flex items-center gap-1 text-neutral-900 dark:text-neutral-100"
						>
							<Icon
								name="material-symbols:hub-outline"
								class="text-base text-[var(--primary)]"
							/>
							<span class="net-node truncate text-xs leading-5"
							></span>
						</div>
					</div>
					<div class="flex flex-col overflow-hidden">
						<span
							class="text-xs text-neutral-500 dark:text-neutral-400 mb-1"
							>地理位置</span
						>
						<div
							class="flex items-center gap-1 text-neutral-900 dark:text-neutral-100"
						>
							<Icon
								name="material-symbols:location-on-outline"
								class="text-base text-[var(--primary)]"
							/>
							<span
								class="net-location truncate text-xs leading-5"
							></span>
						</div>
					</div>
				</div>

				<!-- ISP & ASN -->
				<div class="grid grid-cols-2 gap-2">
					<div class="flex flex-col overflow-hidden">
						<span
							class="text-xs text-neutral-500 dark:text-neutral-400 mb-1"
							>ISP</span
						>
						<span
							class="net-isp text-neutral-900 dark:text-neutral-100 truncate text-xs leading-5"
							title=""></span>
					</div>
					<div class="flex flex-col">
						<span
							class="text-xs text-neutral-500 dark:text-neutral-400 mb-1"
							>ASN</span
						>
						<span
							class="net-asn text-neutral-900 dark:text-neutral-100 text-xs leading-5 font-mono"
						></span>
					</div>
				</div>

				<!-- RTT -->
				<div class="net-rtt-container flex flex-col">
					<div class="flex justify-between items-center mb-1">
						<span
							class="text-xs text-neutral-500 dark:text-neutral-400"
							>握手延迟 (RTT)</span
						>
						<span
							class="net-rtt-val font-mono text-xs font-bold text-[var(--primary)]"
						></span>
					</div>
					<div
						class="h-2 w-full bg-neutral-200 dark:bg-neutral-700 rounded-full overflow-hidden"
					>
						<div
							class="net-rtt-bar h-full bg-[var(--primary)] w-0 transition-all duration-500 ease-out"
						>
						</div>
					</div>
				</div>
			</div>

			<div
				class="net-error hidden flex-col items-center justify-center py-4 text-center"
			>
				<Icon
					name="material-symbols:error-outline"
					class="text-3xl text-red-500 mb-2"
				/>
				<span class="text-xs text-neutral-500 dark:text-neutral-400"
					>网络检测失败</span
				>
				<button
					class="net-retry-btn mt-2 text-xs text-[var(--primary)] hover:underline"
					>重试</button
				>
			</div>
		</div>
	</WidgetLayout>
</network-check-widget>

<script>
	const IPV4_API = "https://ipv4.4848488.xyz/api/ip";
	const IPV6_API = "https://ipv6.4848488.xyz/api/ip";

	class NetworkCheckWidget extends HTMLElement {
		/**
		 * 选择用哪个 IP 接口。
		 *
		 * 实测：ipv4.4848488.xyz 是双栈的（A + AAAA），ipv6.4848488.xyz 只有 AAAA。
		 * 所以：
		 * - 走 IPv6 访问本站（例如 6.blog.haokun.me 这条纯 AAAA 线路）时，
		 *   必须用 ipv6 接口，否则 IPv4-only 的接口在 v6-only 网络下解析失败，
		 *   这个组件会直接进入「网络检测失败」。
		 * - 其余情况优先用 ipv4 接口，失败时回退到 ipv6 接口。
		 */
		private resolvedApi: string | null = null;

		getApiUrl() {
			if (this.resolvedApi) {
				return this.resolvedApi;
			}
			const host = window.location.hostname;
			// 该线路只有 AAAA 记录，访问者必然在 IPv6 网络上
			if (host === "6.blog.haokun.me") {
				return IPV6_API;
			}
			return IPV4_API;
		}

		/** 双栈访客：主接口失败时自动换另一个协议族再试一次 */
		async fetchWithFallback() {
			const primary = this.getApiUrl();
			const fallback = primary === IPV6_API ? IPV4_API : IPV6_API;
			const candidates = [primary, fallback];

			let lastError: unknown = null;
			for (const api of candidates) {
				try {
					const response = await fetch(api);
					if (!response.ok) {
						throw new Error(`HTTP ${response.status}`);
					}
					this.resolvedApi = api;
					return await response.json();
				} catch (error) {
					lastError = error;
				}
			}
			throw lastError ?? new Error("Network API unavailable");
		}

		connectedCallback() {
			this.init();
		}

		init() {
			this.fetchData();

			// Set API link href
			const apiUrl = this.getApiUrl();
			const apiLink = this.querySelector(
				".net-api-link",
			) as HTMLAnchorElement;
			if (apiLink) {
				try {
					const url = new URL(apiUrl);
					apiLink.href = `${url.protocol}//${url.hostname}/`;
				} catch (e) {
					console.error("Failed to parse API URL:", e);
				}
			}

			// Bind retry button
			const retryBtn = this.querySelector(".net-retry-btn");
			if (retryBtn) {
				retryBtn.addEventListener("click", () => {
					this.showLoading();
					this.fetchData();
				});
			}
		}

		async fetchData() {
			try {
				const data = await this.fetchWithFallback();
				this.updateUI(data);
			} catch (error) {
				console.error("Failed to fetch network info:", error);
				this.showError();
			}
		}

		/**
		 * 实测：只有 cf / 6 / blog.4848488.xyz 这几条线路的后端会返回节点与 RTT，
		 * 其它线路（eo / esa / vercel / netlify / render）不返回，需要隐藏这两块。
		 */
		private hostProvidesNodeAndRtt() {
			const allowedHosts = [
				"cf.blog.haokun.me",
				"blog.4848488.xyz",
				"6.blog.haokun.me",
			];
			return allowedHosts.includes(window.location.hostname);
		}

		updateUI(data: any) {
			// IP
			const ipEl = this.querySelector(".net-ip");
			if (ipEl) ipEl.textContent = data.ip;

			// Node
			const nodeEl = this.querySelector(".net-node");
			if (nodeEl) {
				if (this.hostProvidesNodeAndRtt()) {
					nodeEl.textContent = data.node?.name || "Unknown";
					nodeEl.closest(".flex-col")?.classList.remove("hidden");
				} else {
					nodeEl.closest(".flex-col")?.classList.add("hidden");
				}
			}

			// Location
			const locEl = this.querySelector(".net-location");
			if (locEl) {
				const parts = [
					data.location?.city,
					data.location?.region,
				].filter(Boolean);
				locEl.textContent = parts.join(", ") || "Unknown";
			}

			// ISP
			const ispEl = this.querySelector(".net-isp") as HTMLElement;
			if (ispEl) {
				const ispName = data.isp?.name || data.isp?.raw || "Unknown";
				ispEl.textContent = ispName;
				ispEl.title = ispName;
			}

			// ASN
			const asnEl = this.querySelector(".net-asn");
			if (asnEl) asnEl.textContent = `AS${data.asn}`;

			// RTT
			const rttContainer = this.querySelector(
				".net-rtt-container",
			) as HTMLElement;
			if (rttContainer) {
				const rttValue = data.rtt;
				const hasValidRtt =
					rttValue !== undefined &&
					rttValue !== null &&
					rttValue !== 0;

				if (this.hostProvidesNodeAndRtt() && hasValidRtt) {
					rttContainer.classList.remove("hidden");
					const rttValEl = this.querySelector(".net-rtt-val");
					const rttBarEl = this.querySelector(
						".net-rtt-bar",
					) as HTMLElement;
					if (rttValEl && rttBarEl) {
						rttValEl.textContent = `${rttValue} ms`;
						const percentage = Math.min(
							100,
							Math.max(5, (rttValue / 300) * 100),
						);
						rttBarEl.style.width = `${percentage}%`;

						rttBarEl.classList.remove(
							"bg-green-500",
							"bg-yellow-500",
							"bg-red-500",
						);
						if (rttValue < 100) {
							rttBarEl.classList.add("bg-green-500");
						} else if (rttValue < 200) {
							rttBarEl.classList.add("bg-yellow-500");
						} else {
							rttBarEl.classList.add("bg-red-500");
						}
					}
				} else {
					rttContainer.classList.add("hidden");
				}
			}

			this.showData();
		}

		getElements() {
			return {
				loading: this.querySelector(".net-loading"),
				data: this.querySelector(".net-data"),
				error: this.querySelector(".net-error"),
			};
		}

		showLoading() {
			const els = this.getElements();
			els.loading?.classList.remove("hidden");
			els.data?.classList.add("hidden");
			els.data?.classList.remove("flex");
			els.error?.classList.add("hidden");
			els.error?.classList.remove("flex");
		}

		showData() {
			const els = this.getElements();
			els.loading?.classList.add("hidden");
			els.data?.classList.remove("hidden");
			els.data?.classList.add("flex");
			els.error?.classList.add("hidden");
			els.error?.classList.remove("flex");
		}

		showError() {
			const els = this.getElements();
			els.loading?.classList.add("hidden");
			els.data?.classList.add("hidden");
			els.data?.classList.remove("flex");
			els.error?.classList.remove("hidden");
			els.error?.classList.add("flex");
		}
	}

	if (!customElements.get("network-check-widget")) {
		customElements.define("network-check-widget", NetworkCheckWidget);
	}
</script>
