---
import { FilterTabs } from "@components/atoms/filter-tabs";
import { NoteCard, NoteIndex } from "@components/features/notes";
import { NOTE_SUBJECTS } from "@components/features/notes/subject-config";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getSortedNotes } from "../utils/content-utils";

if (!siteConfig.featurePages.notes) {
	return Astro.redirect("/");
}

// 笔记的判定依据是 frontmatter 的 category: Note（见 utils/content-utils.ts）
// 这些文章不会出现在首页、归档、RSS/Atom、侧栏统计与站内搜索里，只在这里聚合
const notes = await getSortedNotes();

const title = i18n(I18nKey.notes);
const subtitle = i18n(I18nKey.notesSubtitle);

// 学科筛选条：只保留实际用到的学科，展示顺序以 NOTE_SUBJECTS 为准
const subjectTabs = NOTE_SUBJECTS.map((subject) => ({
	value: subject.label,
	label: subject.label,
	icon: subject.icon,
	barClass: subject.barClass,
	count: notes.filter((note) =>
		(note.data.tags || []).includes(subject.label),
	).length,
})).filter((tab) => tab.count > 0);

const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.albumsFilterAll),
		icon: "material-symbols:apps",
		count: notes.length,
	},
	...subjectTabs,
];

const hasCover = (entry: (typeof notes)[number]) =>
	entry.data.image !== undefined &&
	entry.data.image !== null &&
	entry.data.image !== "";

const coverNotes = notes.filter(hasCover);
const compactNotes = notes.filter((entry) => !hasCover(entry));

// 将无封面笔记收拢到首次出现的位置，并两两分组。
// 有封面笔记保持原顺序；紧凑笔记之间也保持原相对顺序。
const compactBlocks: Array<Array<(typeof notes)[number]>> = [];
for (let index = 0; index < compactNotes.length; index += 2) {
	compactBlocks.push(compactNotes.slice(index, index + 2));
}

const firstCompactIndex = notes.findIndex((entry) => !hasCover(entry));
const coverNotesBeforeCompact =
	firstCompactIndex === -1
		? coverNotes.length
		: notes.slice(0, firstCompactIndex).filter(hasCover).length;

const noteBlocks = [
	...coverNotes.slice(0, coverNotesBeforeCompact).map((entry) => ({
		type: "cover" as const,
		entries: [entry],
		showIndex: false,
	})),
	...compactBlocks.map((entries, index) => ({
		type: "compact" as const,
		entries,
		showIndex: index === compactBlocks.length - 1 && entries.length === 1,
	})),
	...coverNotes.slice(coverNotesBeforeCompact).map((entry) => ({
		type: "cover" as const,
		entries: [entry],
		showIndex: false,
	})),
];
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 relative w-full px-6 sm:px-9 py-6">
			<PageHeader title={title} subtitle={subtitle} />

			{
				notes.length > 0 && subjectTabs.length > 0 && (
					<div id="notes-filter" class="mb-7">
						<FilterTabs tabs={filterTabs} dataAttr="tags" />
					</div>
				)
			}

			<div
				id="notes-grid"
				class="grid gap-4 sm:gap-5 md:auto-rows-fr md:grid-cols-2"
			>
				{
					noteBlocks.map((block, index) =>
						block.type === "compact" ? (
							<div
								class="note-compact-group onload-animation flex flex-col gap-4 md:grid md:h-full md:grid-rows-2 md:gap-3"
								style={`animation-delay: ${Math.min(index * 60, 360)}ms`}
							>
								{block.entries.map((entry) => (
									<div
										data-note-item
										data-tags={(entry.data.tags || []).join(
											",",
										)}
										class="min-h-0 md:h-full"
									>
										<NoteCard
											entry={entry}
											variant="compact"
										/>
									</div>
								))}
								{block.showIndex && (
									<NoteIndex
										total={notes.length}
										subjects={subjectTabs}
									/>
								)}
							</div>
						) : (
							<div
								data-note-item
								data-tags={(
									block.entries[0].data.tags || []
								).join(",")}
								class="onload-animation h-full"
								style={`animation-delay: ${Math.min(index * 60, 360)}ms`}
							>
								<NoteCard entry={block.entries[0]} />
							</div>
						),
					)
				}
			</div>

			<div id="no-results" class="hidden text-center py-16">
				<Icon
					name="material-symbols:sticky-note-2"
					class="text-6xl text-black/15 dark:text-white/15 mb-4"
				/>
				<p class="text-black/40 dark:text-white/40 text-lg">
					{i18n(I18nKey.notesNoResults)}
				</p>
			</div>

			{
				notes.length === 0 && (
					<div class="text-center py-16">
						<Icon
							name="material-symbols:sticky-note-2"
							class="text-6xl text-black/15 dark:text-white/15 mb-4"
						/>
						<h3 class="text-lg font-medium text-black/90 dark:text-white/90 mb-2">
							{i18n(I18nKey.notesEmpty)}
						</h3>
						<p class="text-black/60 dark:text-white/60">
							{i18n(I18nKey.notesEmptyDesc)}
						</p>
					</div>
				)
			}
		</div>
	</div>

	<script>
		// 笔记详情页的标签链接会带 ?tag=学科 跳到这里：找到对应筛选按钮并触发，
		// 复用共享的 filter-tabs-handler 逻辑，保证与手动点击的行为一致。
		function applyNotesUrlFilter() {
			const tag = (
				new URLSearchParams(window.location.search).get("tag") || ""
			).trim();
			if (!tag) {
				return;
			}

			const tabs = document.querySelectorAll(
				"#notes-filter .filter-tabs-item",
			);
			const target = Array.from(tabs).find(
				(tab) => tab.getAttribute("data-filter-value") === tag,
			);

			// 触发一次点击事件，让共享的 filter-tabs-handler 统一处理筛选逻辑
			target?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
		}

		// 共享脚本在 DOMContentLoaded 里完成初始化，这里必须晚于它执行
		if (document.readyState === "complete") {
			applyNotesUrlFilter();
		} else {
			document.addEventListener("DOMContentLoaded", applyNotesUrlFilter);
		}
		document.addEventListener("astro:page-load", applyNotesUrlFilter);
	</script>

	<style>
		#notes-grid [data-note-item].filtered-out {
			display: none;
		}

		#notes-grid
			> .note-compact-group:not(
				:has([data-note-item]:not(.filtered-out))
			) {
			display: none;
		}

		#notes-grid
			.note-compact-group
			> [data-note-item].filtered-out
			+ .note-index-tile {
			display: none;
		}
	</style>
</MainGridLayout>
